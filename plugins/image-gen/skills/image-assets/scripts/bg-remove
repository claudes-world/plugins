#!/usr/bin/env python3
"""Create a transparent cutout without calling a paid API.

General images use the local rembg package and ONNX models. Flat, limited-palette
backgrounds can use the deterministic border engine. Existing alpha is preserved.
"""

from __future__ import annotations

import argparse
from collections import Counter, deque
from io import BytesIO
from pathlib import Path
import sys


MIN_TRANSPARENT_FRACTION = 0.02
MIN_TRANSPARENT_BORDER_FRACTION = 0.10
LIGHT_FRINGE_MIN_CHANNEL = 200
LIGHT_FRINGE_MAX_CHROMA = 40


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_pillow():
    try:
        from PIL import Image, ImageOps
    except ImportError:
        die(
            "Pillow is required. Install local dependencies in a venv with "
            "`python3 -m pip install pillow 'rembg[cpu]'`."
        )
    return Image, ImageOps


def alpha_stats(image) -> tuple[int, int, int]:
    histogram = image.getchannel("A").histogram()
    return histogram[0], sum(histogram[1:255]), histogram[255]


def has_real_transparency(image) -> bool:
    transparent, partial, opaque = alpha_stats(image)
    total = transparent + partial + opaque
    visible = partial + opaque
    if total == 0 or visible == 0:
        return False
    if (transparent + partial) / total >= MIN_TRANSPARENT_FRACTION:
        return True

    alpha = image.getchannel("A")
    width, height = image.size
    border = []
    for x in range(width):
        border.extend((alpha.getpixel((x, 0)), alpha.getpixel((x, height - 1))))
    for y in range(1, height - 1):
        border.extend((alpha.getpixel((0, y)), alpha.getpixel((width - 1, y))))
    return sum(value < 255 for value in border) / len(border) >= MIN_TRANSPARENT_BORDER_FRACTION


def remove_with_rembg(image, model: str, keep_shadow: bool):
    try:
        from rembg import new_session, remove
    except ImportError:
        die(
            "rembg is not installed. Create a venv and run "
            "`python3 -m pip install pillow 'rembg[cpu]'`, or use "
            "`--engine border` for a provably limited-palette background."
        )

    source = BytesIO()
    image.convert("RGBA").save(source, format="PNG")
    options = {"session": new_session(model), "alpha_matting": keep_shadow}
    if keep_shadow:
        # A soft matte gives low-opacity shadows a chance to survive. The model,
        # not this wrapper, still decides what belongs to the foreground.
        options.update(
            alpha_matting_foreground_threshold=240,
            alpha_matting_background_threshold=5,
            alpha_matting_erode_size=3,
        )
    result = remove(source.getvalue(), **options)
    Image, _ = load_pillow()
    return Image.open(BytesIO(result)).convert("RGBA")


def color_distance(left: tuple[int, int, int], right: tuple[int, int, int]) -> int:
    return max(abs(a - b) for a, b in zip(left, right))


def border_pixels(image) -> list[tuple[int, int, int]]:
    pixels = image.load()
    width, height = image.size
    result = []
    for x in range(width):
        result.extend((pixels[x, 0][:3], pixels[x, height - 1][:3]))
    for y in range(1, height - 1):
        result.extend((pixels[0, y][:3], pixels[width - 1, y][:3]))
    return result


def border_palette(image, tolerance: int) -> list[tuple[int, int, int]]:
    # Quantisation groups antialiased/noisy variants before choosing at most
    # eight border colours. This deliberately refuses photographic borders.
    quantum = max(4, tolerance)
    samples = border_pixels(image)
    buckets = Counter(
        tuple(min(255, (channel // quantum) * quantum + quantum // 2) for channel in rgb)
        for rgb in samples
    )
    palette = [
        color
        for color, count in buckets.most_common(8)
        if count >= max(2, len(samples) // 64)
    ]
    represented = sum(
        1 for rgb in samples if any(color_distance(rgb, color) <= tolerance for color in palette)
    )
    if not palette or represented / len(samples) < 0.85:
        die(
            "the border is not a limited-palette background; install rembg and "
            "use `--engine rembg`"
        )
    return palette


def remove_border_background(image, tolerance: int):
    rgba = image.convert("RGBA")
    width, height = rgba.size
    pixels = rgba.load()
    palette = border_palette(rgba, tolerance)
    queue = deque()

    def enqueue_if_background(x: int, y: int) -> None:
        red, green, blue, alpha = pixels[x, y]
        if alpha == 0:
            return
        if any(color_distance((red, green, blue), color) <= tolerance for color in palette):
            pixels[x, y] = (0, 0, 0, 0)
            queue.append((x, y))

    for x in range(width):
        enqueue_if_background(x, 0)
        enqueue_if_background(x, height - 1)
    for y in range(1, height - 1):
        enqueue_if_background(0, y)
        enqueue_if_background(width - 1, y)

    while queue:
        x, y = queue.popleft()
        for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
            if 0 <= nx < width and 0 <= ny < height:
                enqueue_if_background(nx, ny)
    return rgba


def is_light_fringe(red: int, green: int, blue: int) -> bool:
    return (
        min(red, green, blue) >= LIGHT_FRINGE_MIN_CHANNEL
        and max(red, green, blue) - min(red, green, blue) <= LIGHT_FRINGE_MAX_CHROMA
    )


def clean_halo(image, pixels: int):
    if pixels == 0:
        return image

    rgba = image.copy()
    image_pixels = rgba.load()
    width, height = rgba.size
    for _ in range(pixels):
        fringe = []
        for y in range(height):
            for x in range(width):
                red, green, blue, alpha = image_pixels[x, y]
                if alpha == 0 or not is_light_fringe(red, green, blue):
                    continue
                if any(
                    image_pixels[nx, ny][3] == 0
                    for nx in range(max(0, x - 1), min(width, x + 2))
                    for ny in range(max(0, y - 1), min(height, y + 2))
                    if (nx, ny) != (x, y)
                ):
                    fringe.append((x, y))
        if not fringe:
            break
        for x, y in fringe:
            image_pixels[x, y] = (0, 0, 0, 0)
    return rgba


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Remove an image background locally and write PNG/WebP alpha."
    )
    parser.add_argument("input", help="Source image")
    parser.add_argument("-o", "--output", required=True, help="Output .png or .webp")
    parser.add_argument(
        "--engine",
        choices=("auto", "rembg", "border"),
        default="auto",
        help="auto preserves existing alpha, then uses rembg; border is for flat graphics",
    )
    parser.add_argument(
        "--model",
        choices=("u2net", "u2netp"),
        default="u2net",
        help="Allowed local rembg model (cloud backends are intentionally unavailable)",
    )
    parser.add_argument(
        "--keep-shadow",
        action="store_true",
        help="Ask rembg for a soft alpha matte that may retain natural shadows",
    )
    parser.add_argument(
        "--halo-clean",
        nargs="?",
        type=int,
        const=1,
        default=0,
        metavar="PIXELS",
        help="Remove 1 or 2 light edge-band pixels without eroding dark outlines (default: 1)",
    )
    verification = parser.add_mutually_exclusive_group()
    verification.add_argument(
        "--verify-alpha",
        dest="verify_alpha",
        action="store_true",
        help="Require meaningful transparency and visible content (default)",
    )
    verification.add_argument(
        "--no-verify-alpha",
        dest="verify_alpha",
        action="store_false",
        help="Allow an opaque or fully transparent result",
    )
    parser.set_defaults(verify_alpha=True)
    parser.add_argument(
        "--border-tolerance",
        type=int,
        default=24,
        help="Per-channel tolerance for the limited-palette border engine (0-64)",
    )
    parser.add_argument("--force", action="store_true", help="Overwrite an existing output")
    args = parser.parse_args()

    if args.halo_clean not in (0, 1, 2):
        parser.error("--halo-clean accepts only 1 or 2 pixels")
    if not 0 <= args.border_tolerance <= 64:
        parser.error("--border-tolerance must be between 0 and 64")
    return args


def main() -> None:
    args = parse_args()
    source = Path(args.input)
    output = Path(args.output)
    if not source.is_file():
        die(f"input not found: {source}")
    if output.suffix.lower() not in {".png", ".webp"}:
        die("output must be .png or .webp so alpha can be preserved")
    if output.exists() and not args.force:
        die(f"output exists: {output} (pass --force to replace it)")

    Image, ImageOps = load_pillow()
    with Image.open(source) as opened:
        image = ImageOps.exif_transpose(opened).convert("RGBA")

    if args.engine == "auto" and has_real_transparency(image):
        result = image
        engine = "existing-alpha"
    elif args.engine == "border":
        result = remove_border_background(image, args.border_tolerance)
        engine = "border"
    else:
        result = remove_with_rembg(image, args.model, args.keep_shadow)
        engine = f"rembg/{args.model}"

    result = clean_halo(result, args.halo_clean)
    transparent, partial, opaque = alpha_stats(result)
    if args.verify_alpha and not has_real_transparency(result):
        die(
            "ALPHA VERIFICATION FAILED: output lacks meaningful transparency "
            "or visible content (use --no-verify-alpha only for deliberate raw output)",
            3,
        )

    output.parent.mkdir(parents=True, exist_ok=True)
    result.save(output, format="PNG" if output.suffix.lower() == ".png" else "WEBP")
    print(
        f"wrote {output} via {engine}; alpha pixels: "
        f"transparent={transparent}, partial={partial}, opaque={opaque}"
    )


if __name__ == "__main__":
    main()
