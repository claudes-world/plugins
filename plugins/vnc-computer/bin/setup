#!/usr/bin/env bash
# Optional: create the plugin-local venv (.venv) used automatically by server.py.
# The server itself is stdlib-only; the venv only adds Pillow (smooth LANCZOS
# downscaling, faster PNG encoding) on hosts whose system python lacks it.
# Nothing is installed system-wide.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="$root/.venv"
python="${PYTHON:-python3}"

if [[ ! -x "$venv/bin/python3" ]]; then
  "$python" -m venv --system-site-packages "$venv"
fi
if "$venv/bin/python3" -c 'import PIL' 2>/dev/null; then
  echo "setup: Pillow available ($("$venv/bin/python3" -c 'import PIL; print(PIL.__version__)'))"
else
  "$venv/bin/python3" -m pip install --disable-pip-version-check --quiet 'pillow>=10'
  echo "setup: installed Pillow into $venv"
fi
"$venv/bin/python3" -c 'import sys; sys.path.insert(0, sys.argv[1]); import vnclib.rfb' "$root"
echo "setup: ok -- server.py will use $venv"
